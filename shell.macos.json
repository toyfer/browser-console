{
  "shell": "/bin/zsh",
  "shellArgs": ["-l"],
  "cwd": null,
  "env": {
    "TERM": "xterm-256color",
    "COLORTERM": "truecolor"
  },
  "server": {
    "host": "127.0.0.1",
    "port": 8080,
    "openBrowser": true
  },
  "pty": {
    "cols": 120,
    "rows": 30
  },
  "ui": {
    "fontFamily": "Menlo, Monaco, Cascadia Mono, monospace",
    "fontSize": 15,
    "fontWeight": "normal",
    "lineHeight": 1.0,
    "theme": "dark"
  }
}
